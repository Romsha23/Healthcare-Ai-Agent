# Healthcare AI Agents - Environment Configuration Example
# Copy this file to .env and provide your actual API keys and settings.

# OpenAI API credentials (Required for LLM and Embeddings in production)
OPENAI_API_KEY=your-openai-api-key-here

# API Security: comma-separated list of accepted bearer tokens
API_KEYS=dev-key-123,test-key-456

# Rate Limiting configuration
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SEC=60

# ChromaDB persistence directory
CHROMA_DB_DIR=./chroma_db

# Server port and environment
PORT=8000
ENV=development
